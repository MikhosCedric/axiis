NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of the deployed site, such as https://axiis.example. Used for absolute links in
# metadata, robots.txt and the sitemap. Leave blank locally; it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile site key (public). Leave blank to keep the sign-in CAPTCHA off. Set it only
# after Supabase Attack Protection holds the matching secret (docs/launch-checklist.md, Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
